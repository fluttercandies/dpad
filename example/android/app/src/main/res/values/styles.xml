<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Application theme for Android TV — a platform theme, so the app
         needs no AppCompat dependency (matching the night variant). -->
    <style name="Theme.App" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorPrimary">@android:color/white</item>
        <item name="android:colorPrimaryDark">@android:color/white</item>
    </style>
</resources>
