<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.dpad_example">

    <!-- TV features declaration: the app runs without touch or a gamepad
         (the d-pad is the input), but only on leanback televisions. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.type.television"
        android:required="true" />

    <!-- Network permissions for image loading -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="D-pad Navigation Demo"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/app_banner"
        android:theme="@style/Theme.App">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|uiMode|navigation|density|fontScale"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">

            <!-- TV launcher intent (LEANBACK_LAUNCHER for the TV home rows,
                 LAUNCHER so the app is also reachable from a normal
                 launcher when side-loading) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Flutter v2 embedding -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
